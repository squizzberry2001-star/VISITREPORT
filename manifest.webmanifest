{
  "name": "Regional Bestie Visit Report",
  "short_name": "Bestie Visit",
  "description": "Regional Bestie Visit Report internal app",
  "start_url": "./?source=pwa",
  "scope": "./",
  "id": "/bestie-visit-report",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui",
    "browser"
  ],
  "orientation": "any",
  "background_color": "#f8fafc",
  "theme_color": "#0f766e",
  "categories": [
    "business",
    "productivity"
  ],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}